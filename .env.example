# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://user:password@host/dbname
SECRET_KEY=change-me-to-a-long-random-string

# "sandbox" while building/testing (free, simulated, no real SMS sent).
# Only switch to "live" when using free trial credit for an actual demo.
SMS_MODE=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
